#!/bin/bash

# The TUI draws box borders and centers headers using ${#str} and fold, which
# only count characters (not bytes) under a UTF-8 locale. If the inherited
# locale isn't UTF-8, switch to one when available; otherwise carry on (borders
# may render a few columns short under a non-UTF-8 locale, but nothing breaks).
_cur="${LC_ALL:-${LC_CTYPE:-${LANG:-}}}"
if [[ "${_cur,,}" != *utf-8* && "${_cur,,}" != *utf8* ]]; then
  for _loc in C.UTF-8 C.utf8 en_US.UTF-8 en_US.utf8; do
    if locale -a 2>/dev/null | grep -qixF "$_loc"; then
      export LC_ALL="$_loc"
      break
    fi
  done
fi
unset _cur _loc

UA="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
NOTES_PATH="$OM_NOTES_PATH"
if [[ -z "$NOTES_PATH" ]]; then
  echo "Error: OM_NOTES_PATH not set"
  exit 1
fi
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/om"
HISTORY_FILE="$CACHE_DIR/history.log"

# Terminal state (save early for cleanup)
ORIG_STTY=$(stty -g 2>/dev/null || echo "")

# TUI state. The viewer shows three slots (SELECTION 1..3, 0=none); each slot
# is a (book, number) pair. Both views reuse it: the default/history view shows
# three books at one number; the single-book view shows one book at three
# consecutive numbers.
SELECTION=0       # 0=none, 1..3 = slot index
NOTES_SELECTED=0  # 0=quote selected, 1=notes selected (when visible)
NUM=""            # primary point number (header + history)
VIEW_HEADER=""    # centered title line for the current view

# Per-slot arrays (slot N ↔ SELECTION N ↔ array index N-1)
SLOT_BOOKS=()         # book key per slot
SLOT_NUMS=()          # point number per slot
SLOT_QUOTES=()        # fetched quote text per slot
SLOT_NOTES_VISIBLE=() # 0/1 notes-expanded flag per slot
SLOT_TITLE=()         # box title label per slot
SLOT_DIM=()           # dim frame color per slot
SLOT_BRIGHT=()        # bright frame color per slot

# History menu state
HISTORY_ENTRIES=()   # each item: "epoch\tnum"
HISTORY_SEL=0        # highlighted row index
HISTORY_SELECTED=""  # number chosen by the user (empty = cancelled)

# Get random number in [1, max]: tries random.org API first, falls back to $RANDOM
get_random_number() {
  local max="${1:-1055}"
  if [[ -n "$RANDOM_ORG_API_KEY" ]]; then
    local result
    result=$(curl -s --connect-timeout 3 "https://api.random.org/json-rpc/4/invoke" \
      -H "Content-Type: application/json" \
      -d "{
        \"jsonrpc\": \"2.0\",
        \"method\": \"generateIntegers\",
        \"params\": {
          \"apiKey\": \"$RANDOM_ORG_API_KEY\",
          \"n\": 1,
          \"min\": 1,
          \"max\": $max
        },
        \"id\": 1
      }" 2>/dev/null | jq -r '.result.random.data[0]' 2>/dev/null)

    if [[ -n "$result" && "$result" != "null" && "$result" =~ ^[0-9]+$ ]]; then
      echo "$result"
      return
    fi
  fi
  # Fallback to bash RANDOM
  echo $(( RANDOM % max + 1 ))
}

# Max point number per book
book_max() {
  case "$1" in
    caminho) echo 999 ;;
    sulco)   echo 1000 ;;
    forja)   echo 1055 ;;
    *)       echo 1055 ;;
  esac
}

# Build the escriva.org URL for a book + number
book_url() {
  local book="$1" num="$2"
  case "$book" in
    caminho) echo "https://escriva.org/pt-br/camino/$num/" ;;
    sulco)   echo "https://escriva.org/pt-br/surco/$num/" ;;
    forja)   echo "https://escriva.org/pt-br/forja/$num/" ;;
  esac
}

# Use argument if provided, otherwise fetch random number
get_number() {
  if [[ -n "$1" ]]; then
    if ! [[ "$1" =~ ^[0-9]+$ ]] || [[ "$1" -lt 1 || "$1" -gt 1055 ]]; then
      echo "Error: number must be between 1 and 1055"
      exit 1
    fi
    NUM="$1"
  else
    NUM=$(get_random_number)
  fi
}

# Cache functions
cache_file() {
  local book="$1" num="$2"
  echo "$CACHE_DIR/${book}_${num}.txt"
}

get_cached_quote() {
  local book="$1" num="$2"
  local file
  file=$(cache_file "$book" "$num")
  [[ -f "$file" ]] && cat "$file"
}

save_to_cache() {
  local book="$1" num="$2" quote="$3"
  mkdir -p "$CACHE_DIR"
  local file
  file=$(cache_file "$book" "$num")
  echo "$quote" > "$file"
}

# Append the current number to the history log with a timestamp
record_history() {
  mkdir -p "$CACHE_DIR"
  printf '%s\t%s\n' "$(date +%s)" "$NUM" >> "$HISTORY_FILE"
}

extract_quote() {
  local html="$1"
  echo "$html" | grep -oP '(?<=<article id="contenido">).*?(?=</article>)' | \
    sed 's/<[^>]*>//g' | \
    sed "s/^[0-9]*\s*//" | \
    sed 's/&#160;.*//g; s/Este ponto em outro idioma.*//g; s/Documento impresso de.*//g' | \
    sed 's/Temas.*//g' | \
    sed 's/&nbsp;/ /g; s/&mdash;/—/g; s/&ldquo;/"/g; s/&rdquo;/"/g; s/&amp;/\&/g' | \
    perl -MHTML::Entities -pe 'decode_entities($_);' 2>/dev/null || cat
}

# Fetch a single quote for a book + number (cache-aware). Empty if not found.
fetch_quote_num() {
  local book="$1" num="$2"
  local cached quote html url

  cached=$(get_cached_quote "$book" "$num")
  if [[ -n "$cached" ]]; then
    echo "$cached"
    return
  fi

  url=$(book_url "$book" "$num")
  html=$(curl -s -A "$UA" "$url")
  quote=$(extract_quote "$html")

  if [[ -z "$quote" || "$quote" =~ "404" || ${#quote} -lt 5 ]]; then
    echo ""
    return
  fi

  save_to_cache "$book" "$num" "$quote"
  echo "$quote"
}

fetch_quotes() {
  local i
  for i in 0 1 2; do
    SLOT_QUOTES[$i]=$(fetch_quote_num "${SLOT_BOOKS[$i]}" "${SLOT_NUMS[$i]}")
  done
}

# Get notes file path for a book + number
notes_file() {
  local book="$1" num="$2"
  printf "%s/%04d_%s.md" "$NOTES_PATH" "$num" "$book"
}

# Load notes content (everything after ---)
load_notes() {
  local book="$1" num="$2"
  local file
  file=$(notes_file "$book" "$num")
  if [[ -f "$file" ]]; then
    sed -n '/^---$/,$ { /^---$/d; p; }' "$file"
  fi
}

# Create notes file with header if doesn't exist
ensure_notes_file() {
  local book="$1" num="$2" quote="$3"
  local file
  file=$(notes_file "$book" "$num")

  mkdir -p "$NOTES_PATH"

  if [[ ! -f "$file" ]]; then
    local title
    case "$book" in
      caminho) title="Caminho" ;;
      sulco) title="Sulco" ;;
      forja) title="Forja" ;;
    esac

    {
      echo "# $title № $num"
      echo ""
      echo "$quote" | fold -s -w 70 | sed 's/^/> /'
      echo ""
      echo "---"
      echo ""
    } > "$file"
  fi
}

# Static border strings (62 cols; top borders are built per-box by seq_border_top)
BORDER_BOTTOM="└────────────────────────────────────────────────────────────┘"
NOTES_TOP="  ┌─ notas ────────────────────────────────────────────────┐"
NOTES_BOTTOM="  └────────────────────────────────────────────────────────┘"

render_quote() {
  local title="$1"
  local quote="$2"
  local color_dim="$3"
  local color_bright="$4"
  local highlighted="$5"
  local notes_visible="$6"
  local notes_selected="$7"
  local book_key="$8"
  local num="$9"

  local frame_color text_color
  if [[ "$highlighted" == "1" && "$notes_selected" != "1" ]]; then
    frame_color="$color_bright"
    text_color="\033[1;37m"
  else
    frame_color="$color_dim"
    text_color="\033[0;37m"
  fi

  # Top border (label embedded, 62 cols)
  echo -e "${frame_color}$(seq_border_top "$title")\033[0m"

  # Quote text
  if [[ -n "$quote" ]]; then
    echo "$quote" | fold -s -w 60 | while IFS= read -r line; do
      # %b expands the color escapes; %s prints content literally so backslash
      # sequences in the text aren't interpreted by echo -e
      printf '%b  %s\033[0m\n' "$text_color" "$line"
    done
  else
    echo -e "\033[0;90m  (ponto não encontrado)\033[0m"
  fi

  # Bottom border
  echo -e "${frame_color}${BORDER_BOTTOM}\033[0m"

  # Render notes if visible
  if [[ "$notes_visible" == "1" ]]; then
    local notes_frame_color notes_text_color
    if [[ "$notes_selected" == "1" ]]; then
      notes_frame_color="$color_bright"
      notes_text_color="\033[1;37m"
    else
      notes_frame_color="$color_dim"
      notes_text_color="\033[0;37m"
    fi

    echo -e "${notes_frame_color}${NOTES_TOP}\033[0m"

    local notes
    notes=$(load_notes "$book_key" "$num")
    if [[ -n "$notes" ]]; then
      echo "$notes" | fold -s -w 56 | while IFS= read -r line; do
        # %s keeps user-authored note text literal (backslashes, \c, etc.)
        printf '%b    %s\033[0m\n' "$notes_text_color" "$line"
      done
    else
      echo -e "\033[0;90m    (pressione Enter para adicionar notas)\033[0m"
    fi

    echo -e "${notes_frame_color}${NOTES_BOTTOM}\033[0m"
  fi

  echo ""
}

render_all() {
  # Clear screen and move cursor to top
  printf '\033[2J\033[H'

  # Centered header
  local pad spaces
  pad=$(( (62 - ${#VIEW_HEADER}) / 2 ))
  (( pad < 0 )) && pad=0
  printf -v spaces '%*s' "$pad" ""
  echo -e "\n\033[1;33m══════════════════════════════════════════════════════════════\033[0m"
  echo -e "\033[1;36m${spaces}${VIEW_HEADER}\033[0m"
  echo -e "\033[1;33m══════════════════════════════════════════════════════════════\033[0m\n"

  local i slot highlighted notes_sel
  for i in 0 1 2; do
    slot=$(( i + 1 ))
    highlighted=0; notes_sel=0
    [[ $SELECTION -eq $slot ]] && highlighted=1
    [[ $SELECTION -eq $slot && $NOTES_SELECTED -eq 1 ]] && notes_sel=1
    render_quote "${SLOT_TITLE[$i]}" "${SLOT_QUOTES[$i]}" "${SLOT_DIM[$i]}" "${SLOT_BRIGHT[$i]}" \
      "$highlighted" "${SLOT_NOTES_VISIBLE[$i]}" "$notes_sel" "${SLOT_BOOKS[$i]}" "${SLOT_NUMS[$i]}"
  done

  echo -e "\033[0;90m  ↑↓ navegar  Enter selecionar/editar  q sair\033[0m"
}

# Whether a slot is currently selected (1..3)
slot_selected() {
  [[ $SELECTION -ge 1 && $SELECTION -le 3 ]]
}

# Get notes visibility for current selection
get_notes_visible() {
  if slot_selected; then echo "${SLOT_NOTES_VISIBLE[$((SELECTION-1))]}"; else echo "0"; fi
}

# Toggle notes visibility for current selection
toggle_notes() {
  if slot_selected; then
    local i=$((SELECTION-1))
    SLOT_NOTES_VISIBLE[$i]=$(( 1 - ${SLOT_NOTES_VISIBLE[$i]} ))
  fi
}

# Get book key for current selection
get_book_key() {
  slot_selected && echo "${SLOT_BOOKS[$((SELECTION-1))]}"
}

# Get quote for current selection
get_current_quote() {
  slot_selected && echo "${SLOT_QUOTES[$((SELECTION-1))]}"
}

# Get point number for current selection
get_current_num() {
  slot_selected && echo "${SLOT_NUMS[$((SELECTION-1))]}"
}

# Navigation: move down
move_down() {
  if [[ $SELECTION -eq 0 ]]; then
    SELECTION=1
    NOTES_SELECTED=0
  elif [[ $NOTES_SELECTED -eq 0 ]]; then
    # On a quote, check if notes are visible
    local notes_vis
    notes_vis=$(get_notes_visible)
    if [[ "$notes_vis" == "1" ]]; then
      # Move to notes section
      NOTES_SELECTED=1
    else
      # Move to next quote
      SELECTION=$((SELECTION % 3 + 1))
    fi
  else
    # On notes, move to next quote
    NOTES_SELECTED=0
    SELECTION=$((SELECTION % 3 + 1))
  fi
}

# Navigation: move up
move_up() {
  if [[ $SELECTION -eq 0 ]]; then
    SELECTION=3
    NOTES_SELECTED=0
    # If the last slot's notes are visible, select them
    [[ ${SLOT_NOTES_VISIBLE[2]} -eq 1 ]] && NOTES_SELECTED=1
  elif [[ $NOTES_SELECTED -eq 1 ]]; then
    # On notes, move up to quote
    NOTES_SELECTED=0
  else
    # On quote, move to previous
    SELECTION=$(( (SELECTION - 2 + 3) % 3 + 1 ))
    # Check if that quote has notes visible
    local notes_vis
    notes_vis=$(get_notes_visible)
    if [[ "$notes_vis" == "1" ]]; then
      NOTES_SELECTED=1
    fi
  fi
}

# Handle Enter key
handle_enter() {
  if [[ $SELECTION -eq 0 ]]; then
    return
  fi

  if [[ $NOTES_SELECTED -eq 0 ]]; then
    # On quote: toggle notes visibility
    toggle_notes
  else
    # On notes: open editor
    local book quote num file
    book=$(get_book_key)
    quote=$(get_current_quote)
    num=$(get_current_num)
    file=$(notes_file "$book" "$num")

    ensure_notes_file "$book" "$num" "$quote"

    # Restore terminal before editor
    stty "$ORIG_STTY"
    printf '\033[?25h'  # Show cursor

    ${EDITOR:-vim} "$file"

    # Restore TUI terminal mode
    printf '\033[?25l'  # Hide cursor
    stty -icanon -echo

    # Force refresh to show updated notes
    render_all
  fi
}

# Render the history menu
render_history() {
  printf '\033[2J\033[H'

  echo -e "\n\033[1;33m══════════════════════════════════════════════════════════════\033[0m"
  echo -e "\033[1;36m                       HISTÓRICO\033[0m"
  echo -e "\033[1;33m══════════════════════════════════════════════════════════════\033[0m\n"

  local i epoch num datestr
  for i in "${!HISTORY_ENTRIES[@]}"; do
    IFS=$'\t' read -r epoch num <<< "${HISTORY_ENTRIES[$i]}"
    datestr=$(date -d "@$epoch" '+%Y-%m-%d %H:%M' 2>/dev/null)
    if [[ $i -eq $HISTORY_SEL ]]; then
      printf '\033[1;92m  ▶ № %-5s\033[0m  \033[0;37m%s\033[0m\n' "$num" "$datestr"
    else
      printf '\033[0;90m    № %-5s  %s\033[0m\n' "$num" "$datestr"
    fi
  done

  echo -e "\n\033[0;90m  ↑↓ navegar  Enter abrir  q sair\033[0m"
}

# Show the history menu; sets HISTORY_SELECTED to the chosen number (or empty)
history_menu() {
  HISTORY_SELECTED=""

  # Load entries: most recent first, deduped by number, capped at 30
  HISTORY_ENTRIES=()
  if [[ -f "$HISTORY_FILE" ]]; then
    local line
    while IFS= read -r line; do
      [[ -n "$line" ]] && HISTORY_ENTRIES+=("$line")
    done < <(tac "$HISTORY_FILE" | awk -F'\t' 'NF==2 && !seen[$2]++' | head -n 30)
  fi

  if [[ ${#HISTORY_ENTRIES[@]} -eq 0 ]]; then
    echo "Sem histórico ainda."
    return
  fi

  HISTORY_SEL=0
  printf '\033[?25l'  # Hide cursor
  stty -icanon -echo
  render_history

  while true; do
    local char seq
    IFS= read -rsn1 char || return
    case "$char" in
      q|Q)
        return
        ;;
      $'\x1b')
        IFS= read -rsn2 seq
        case "$seq" in
          '[A') ((HISTORY_SEL > 0)) && ((HISTORY_SEL--)); render_history ;;
          '[B') ((HISTORY_SEL < ${#HISTORY_ENTRIES[@]} - 1)) && ((HISTORY_SEL++)); render_history ;;
        esac
        ;;
      $'\r'|$'\n'|'')
        local epoch num
        IFS=$'\t' read -r epoch num <<< "${HISTORY_ENTRIES[$HISTORY_SEL]}"
        HISTORY_SELECTED="$num"
        return
        ;;
    esac
  done
}

# Build a 62-column top border with an embedded label
seq_border_top() {
  local label="$1"
  local prefix="─ ${label} "
  local dashes=$(( 60 - ${#prefix} ))
  (( dashes < 0 )) && dashes=0
  local fill="" i
  for (( i = 0; i < dashes; i++ )); do fill+="─"; done
  printf '┌%s%s┐' "$prefix" "$fill"
}

# Slot colors per book: dim and bright frame colors
book_colors() {
  case "$1" in
    caminho) echo "\033[1;32m \033[1;92m" ;;
    sulco)   echo "\033[1;34m \033[1;94m" ;;
    forja)   echo "\033[1;35m \033[1;95m" ;;
    *)       echo "\033[1;37m \033[1;97m" ;;
  esac
}

# Default/history view: the three books at one number ($NUM must be set)
setup_three_books() {
  local book dim bright
  SLOT_BOOKS=("caminho" "sulco" "forja")
  SLOT_NUMS=("$NUM" "$NUM" "$NUM")
  SLOT_TITLE=("CAMINHO" "SULCO" "FORJA")
  SLOT_DIM=(); SLOT_BRIGHT=()
  for book in "${SLOT_BOOKS[@]}"; do
    read -r dim bright <<< "$(book_colors "$book")"
    SLOT_DIM+=("$dim"); SLOT_BRIGHT+=("$bright")
  done
  SLOT_NOTES_VISIBLE=(0 0 0)
  VIEW_HEADER="№ $NUM"
  SELECTION=0  # nothing focused until the user navigates
}

# Single-book view (om caminho|sulco|forja): a random point and its neighbors
setup_sequence() {
  local book="$1"
  local title max dim bright prev next
  case "$book" in
    caminho) title="CAMINHO" ;;
    sulco)   title="SULCO" ;;
    forja)   title="FORJA" ;;
  esac
  max=$(book_max "$book")

  # Pick a number whose previous and next neighbors both exist
  NUM=$(get_random_number "$max")
  (( NUM < 2 )) && NUM=2
  (( NUM > max - 1 )) && NUM=$(( max - 1 ))
  prev=$(( NUM - 1 )); next=$(( NUM + 1 ))

  read -r dim bright <<< "$(book_colors "$book")"
  SLOT_BOOKS=("$book" "$book" "$book")
  SLOT_NUMS=("$prev" "$NUM" "$next")
  SLOT_TITLE=("$title № $prev · anterior" "$title № $NUM" "$title № $next · próximo")
  SLOT_DIM=("$dim" "$dim" "$dim")
  SLOT_BRIGHT=("$bright" "$bright" "$bright")
  SLOT_NOTES_VISIBLE=(0 0 0)
  VIEW_HEADER="$title № $NUM"
  SELECTION=2  # open focused on the central point
}

cleanup() {
  [[ -n "$ORIG_STTY" ]] && stty "$ORIG_STTY"
  printf '\033[?25h'  # Show cursor
  echo ""
  exit 0
}

# Fetch quotes for $NUM and run the interactive viewer
run_viewer() {
  echo "Loading quotes..."
  fetch_quotes

  # Hide cursor
  printf '\033[?25l'

  render_all

  # Set terminal for single-char input without echo
  stty -icanon -echo

  while true; do
    # Read a single character; EOF (e.g. Ctrl-D) exits cleanly instead of
    # looping forever on the empty-string (Enter) case
    local char
    IFS= read -rsn1 char || break

    case "$char" in
      q|Q)
        break
        ;;
      $'\x1b')
        # Escape sequence - read more
        IFS= read -rsn2 seq
        case "$seq" in
          '[A') move_up; render_all ;;    # Up arrow
          '[B') move_down; render_all ;;  # Down arrow
        esac
        ;;
      $'\r'|$'\n'|'')
        # Enter key
        handle_enter
        render_all
        ;;
    esac
  done
}

main() {
  case "$1" in
    -h|--history)
      trap cleanup EXIT INT TERM
      history_menu
      # Nothing chosen: restore terminal and quit
      [[ -z "$HISTORY_SELECTED" ]] && exit 0
      NUM="$HISTORY_SELECTED"
      setup_three_books
      ;;
    caminho|sulco|forja)
      trap cleanup EXIT INT TERM
      setup_sequence "$1"
      ;;
    *)
      # get_number may exit 1 on bad input; set trap afterwards
      get_number "$1"
      trap cleanup EXIT INT TERM
      setup_three_books
      ;;
  esac

  record_history
  run_viewer
}

main "$@"
