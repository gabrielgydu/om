#!/bin/bash

UA="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
NOTES_PATH="$OM_NOTES_PATH"
if [[ -z "$NOTES_PATH" ]]; then
  echo "Error: OM_NOTES_PATH not set"
  exit 1
fi
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/om"
HISTORY_FILE="$CACHE_DIR/history.log"

# Terminal state (save early for cleanup)
ORIG_STTY=$(stty -g 2>/dev/null || echo "")

# State
SELECTION=0  # 0=none, 1=caminho, 2=sulco, 3=forja
CAMINHO_NOTES_VISIBLE=0
SULCO_NOTES_VISIBLE=0
FORJA_NOTES_VISIBLE=0
NOTES_SELECTED=0  # 0=quote selected, 1=notes selected (when visible)

# Quote storage
CAMINHO_QUOTE=""
SULCO_QUOTE=""
FORJA_QUOTE=""
NUM=""

# History menu state
HISTORY_ENTRIES=()   # each item: "epoch\tnum"
HISTORY_SEL=0        # highlighted row index
HISTORY_SELECTED=""  # number chosen by the user (empty = cancelled)

# Get random number: tries random.org API first, falls back to $RANDOM
get_random_number() {
  if [[ -n "$RANDOM_ORG_API_KEY" ]]; then
    local result
    result=$(curl -s --connect-timeout 3 "https://api.random.org/json-rpc/4/invoke" \
      -H "Content-Type: application/json" \
      -d "{
        \"jsonrpc\": \"2.0\",
        \"method\": \"generateIntegers\",
        \"params\": {
          \"apiKey\": \"$RANDOM_ORG_API_KEY\",
          \"n\": 1,
          \"min\": 1,
          \"max\": 1055
        },
        \"id\": 1
      }" 2>/dev/null | jq -r '.result.random.data[0]' 2>/dev/null)

    if [[ -n "$result" && "$result" != "null" && "$result" =~ ^[0-9]+$ ]]; then
      echo "$result"
      return
    fi
  fi
  # Fallback to bash RANDOM
  echo $(( RANDOM % 1055 + 1 ))
}

# Use argument if provided, otherwise fetch random number
get_number() {
  if [[ -n "$1" ]]; then
    if ! [[ "$1" =~ ^[0-9]+$ ]] || [[ "$1" -lt 1 || "$1" -gt 1055 ]]; then
      echo "Error: number must be between 1 and 1055"
      exit 1
    fi
    NUM="$1"
  else
    NUM=$(get_random_number)
  fi
}

# Cache functions
cache_file() {
  local book="$1" num="$2"
  echo "$CACHE_DIR/${book}_${num}.txt"
}

get_cached_quote() {
  local book="$1" num="$2"
  local file
  file=$(cache_file "$book" "$num")
  [[ -f "$file" ]] && cat "$file"
}

save_to_cache() {
  local book="$1" num="$2" quote="$3"
  mkdir -p "$CACHE_DIR"
  local file
  file=$(cache_file "$book" "$num")
  echo "$quote" > "$file"
}

# Append the current number to the history log with a timestamp
record_history() {
  mkdir -p "$CACHE_DIR"
  printf '%s\t%s\n' "$(date +%s)" "$NUM" >> "$HISTORY_FILE"
}

extract_quote() {
  local html="$1"
  echo "$html" | grep -oP '(?<=<article id="contenido">).*?(?=</article>)' | \
    sed 's/<[^>]*>//g' | \
    sed "s/^[0-9]*\s*//" | \
    sed 's/&#160;.*//g; s/Este ponto em outro idioma.*//g; s/Documento impresso de.*//g' | \
    sed 's/Temas.*//g' | \
    sed 's/&nbsp;/ /g; s/&mdash;/—/g; s/&ldquo;/"/g; s/&rdquo;/"/g; s/&amp;/\&/g' | \
    perl -MHTML::Entities -pe 'decode_entities($_);' 2>/dev/null || cat
}

fetch_quote_single() {
  local book="$1" url="$2"
  local cached quote html

  cached=$(get_cached_quote "$book" "$NUM")
  if [[ -n "$cached" ]]; then
    echo "$cached"
    return
  fi

  html=$(curl -s -A "$UA" "$url")
  quote=$(extract_quote "$html")

  if [[ -z "$quote" || "$quote" =~ "404" || ${#quote} -lt 5 ]]; then
    echo ""
    return
  fi

  save_to_cache "$book" "$NUM" "$quote"
  echo "$quote"
}

fetch_quotes() {
  CAMINHO_QUOTE=$(fetch_quote_single "caminho" "https://escriva.org/pt-br/camino/$NUM/")
  SULCO_QUOTE=$(fetch_quote_single "sulco" "https://escriva.org/pt-br/surco/$NUM/")
  FORJA_QUOTE=$(fetch_quote_single "forja" "https://escriva.org/pt-br/forja/$NUM/")
}

# Get notes file path for a book
notes_file() {
  local book="$1"
  printf "%s/%04d_%s.md" "$NOTES_PATH" "$NUM" "$book"
}

# Load notes content (everything after ---)
load_notes() {
  local book="$1"
  local file
  file=$(notes_file "$book")
  if [[ -f "$file" ]]; then
    sed -n '/^---$/,$ { /^---$/d; p; }' "$file"
  fi
}

# Create notes file with header if doesn't exist
ensure_notes_file() {
  local book="$1"
  local quote="$2"
  local file
  file=$(notes_file "$book")

  mkdir -p "$NOTES_PATH"

  if [[ ! -f "$file" ]]; then
    local title
    case "$book" in
      caminho) title="Caminho" ;;
      sulco) title="Sulco" ;;
      forja) title="Forja" ;;
    esac

    {
      echo "# $title № $NUM"
      echo ""
      echo "$quote" | fold -s -w 70 | sed 's/^/> /'
      echo ""
      echo "---"
      echo ""
    } > "$file"
  fi
}

# Hardcoded border strings (62 chars wide)
BORDER_TOP_CAMINHO="┌─ CAMINHO ──────────────────────────────────────────────────┐"
BORDER_TOP_SULCO="┌─ SULCO ────────────────────────────────────────────────────┐"
BORDER_TOP_FORJA="┌─ FORJA ────────────────────────────────────────────────────┐"
BORDER_BOTTOM="└────────────────────────────────────────────────────────────┘"
NOTES_TOP="  ┌─ notas ────────────────────────────────────────────────┐"
NOTES_BOTTOM="  └────────────────────────────────────────────────────────┘"

render_quote() {
  local name="$1"
  local quote="$2"
  local color_dim="$3"
  local color_bright="$4"
  local highlighted="$5"
  local notes_visible="$6"
  local notes_selected="$7"
  local book_key="$8"

  local frame_color text_color
  if [[ "$highlighted" == "1" && "$notes_selected" != "1" ]]; then
    frame_color="$color_bright"
    text_color="\033[1;37m"
  else
    frame_color="$color_dim"
    text_color="\033[0;37m"
  fi

  # Top border
  local top_border
  case "$name" in
    CAMINHO) top_border="$BORDER_TOP_CAMINHO" ;;
    SULCO) top_border="$BORDER_TOP_SULCO" ;;
    FORJA) top_border="$BORDER_TOP_FORJA" ;;
  esac
  echo -e "${frame_color}${top_border}\033[0m"

  # Quote text
  if [[ -n "$quote" ]]; then
    echo "$quote" | fold -s -w 60 | while IFS= read -r line; do
      echo -e "${text_color}  $line\033[0m"
    done
  else
    echo -e "\033[0;90m  (ponto não encontrado)\033[0m"
  fi

  # Bottom border
  echo -e "${frame_color}${BORDER_BOTTOM}\033[0m"

  # Render notes if visible
  if [[ "$notes_visible" == "1" ]]; then
    local notes_frame_color notes_text_color
    if [[ "$notes_selected" == "1" ]]; then
      notes_frame_color="$color_bright"
      notes_text_color="\033[1;37m"
    else
      notes_frame_color="$color_dim"
      notes_text_color="\033[0;37m"
    fi

    echo -e "${notes_frame_color}${NOTES_TOP}\033[0m"

    local notes
    notes=$(load_notes "$book_key")
    if [[ -n "$notes" ]]; then
      echo "$notes" | fold -s -w 56 | while IFS= read -r line; do
        echo -e "${notes_text_color}    $line\033[0m"
      done
    else
      echo -e "\033[0;90m    (pressione Enter para adicionar notas)\033[0m"
    fi

    echo -e "${notes_frame_color}${NOTES_BOTTOM}\033[0m"
  fi

  echo ""
}

render_all() {
  # Clear screen and move cursor to top
  printf '\033[2J\033[H'

  echo -e "\n\033[1;33m══════════════════════════════════════════════════════════════\033[0m"
  echo -e "\033[1;36m                        № $NUM\033[0m"
  echo -e "\033[1;33m══════════════════════════════════════════════════════════════\033[0m\n"

  # Caminho
  local caminho_highlighted=0 caminho_notes_sel=0
  [[ $SELECTION -eq 1 ]] && caminho_highlighted=1
  [[ $SELECTION -eq 1 && $NOTES_SELECTED -eq 1 ]] && caminho_notes_sel=1
  render_quote "CAMINHO" "$CAMINHO_QUOTE" "\033[1;32m" "\033[1;92m" "$caminho_highlighted" "$CAMINHO_NOTES_VISIBLE" "$caminho_notes_sel" "caminho"

  # Sulco
  local sulco_highlighted=0 sulco_notes_sel=0
  [[ $SELECTION -eq 2 ]] && sulco_highlighted=1
  [[ $SELECTION -eq 2 && $NOTES_SELECTED -eq 1 ]] && sulco_notes_sel=1
  render_quote "SULCO" "$SULCO_QUOTE" "\033[1;34m" "\033[1;94m" "$sulco_highlighted" "$SULCO_NOTES_VISIBLE" "$sulco_notes_sel" "sulco"

  # Forja
  local forja_highlighted=0 forja_notes_sel=0
  [[ $SELECTION -eq 3 ]] && forja_highlighted=1
  [[ $SELECTION -eq 3 && $NOTES_SELECTED -eq 1 ]] && forja_notes_sel=1
  render_quote "FORJA" "$FORJA_QUOTE" "\033[1;35m" "\033[1;95m" "$forja_highlighted" "$FORJA_NOTES_VISIBLE" "$forja_notes_sel" "forja"

  echo -e "\033[0;90m  ↑↓ navegar  Enter selecionar/editar  q sair\033[0m"
}

# Get notes visibility for current selection
get_notes_visible() {
  case $SELECTION in
    1) echo "$CAMINHO_NOTES_VISIBLE" ;;
    2) echo "$SULCO_NOTES_VISIBLE" ;;
    3) echo "$FORJA_NOTES_VISIBLE" ;;
    *) echo "0" ;;
  esac
}

# Toggle notes visibility for current selection
toggle_notes() {
  case $SELECTION in
    1) CAMINHO_NOTES_VISIBLE=$((1 - CAMINHO_NOTES_VISIBLE)) ;;
    2) SULCO_NOTES_VISIBLE=$((1 - SULCO_NOTES_VISIBLE)) ;;
    3) FORJA_NOTES_VISIBLE=$((1 - FORJA_NOTES_VISIBLE)) ;;
  esac
}

# Get book key for current selection
get_book_key() {
  case $SELECTION in
    1) echo "caminho" ;;
    2) echo "sulco" ;;
    3) echo "forja" ;;
  esac
}

# Get quote for current selection
get_current_quote() {
  case $SELECTION in
    1) echo "$CAMINHO_QUOTE" ;;
    2) echo "$SULCO_QUOTE" ;;
    3) echo "$FORJA_QUOTE" ;;
  esac
}

# Navigation: move down
move_down() {
  if [[ $SELECTION -eq 0 ]]; then
    SELECTION=1
    NOTES_SELECTED=0
  elif [[ $NOTES_SELECTED -eq 0 ]]; then
    # On a quote, check if notes are visible
    local notes_vis
    notes_vis=$(get_notes_visible)
    if [[ "$notes_vis" == "1" ]]; then
      # Move to notes section
      NOTES_SELECTED=1
    else
      # Move to next quote
      SELECTION=$((SELECTION % 3 + 1))
    fi
  else
    # On notes, move to next quote
    NOTES_SELECTED=0
    SELECTION=$((SELECTION % 3 + 1))
  fi
}

# Navigation: move up
move_up() {
  if [[ $SELECTION -eq 0 ]]; then
    SELECTION=3
    NOTES_SELECTED=0
    # If Forja notes visible, select them
    [[ $FORJA_NOTES_VISIBLE -eq 1 ]] && NOTES_SELECTED=1
  elif [[ $NOTES_SELECTED -eq 1 ]]; then
    # On notes, move up to quote
    NOTES_SELECTED=0
  else
    # On quote, move to previous
    SELECTION=$(( (SELECTION - 2 + 3) % 3 + 1 ))
    # Check if that quote has notes visible
    local notes_vis
    notes_vis=$(get_notes_visible)
    if [[ "$notes_vis" == "1" ]]; then
      NOTES_SELECTED=1
    fi
  fi
}

# Handle Enter key
handle_enter() {
  if [[ $SELECTION -eq 0 ]]; then
    return
  fi

  if [[ $NOTES_SELECTED -eq 0 ]]; then
    # On quote: toggle notes visibility
    toggle_notes
  else
    # On notes: open editor
    local book quote file
    book=$(get_book_key)
    quote=$(get_current_quote)
    file=$(notes_file "$book")

    ensure_notes_file "$book" "$quote"

    # Restore terminal before editor
    stty "$ORIG_STTY"
    printf '\033[?25h'  # Show cursor

    ${EDITOR:-vim} "$file"

    # Restore TUI terminal mode
    printf '\033[?25l'  # Hide cursor
    stty -icanon -echo

    # Force refresh to show updated notes
    render_all
  fi
}

# Render the history menu
render_history() {
  printf '\033[2J\033[H'

  echo -e "\n\033[1;33m══════════════════════════════════════════════════════════════\033[0m"
  echo -e "\033[1;36m                       HISTÓRICO\033[0m"
  echo -e "\033[1;33m══════════════════════════════════════════════════════════════\033[0m\n"

  local i epoch num datestr
  for i in "${!HISTORY_ENTRIES[@]}"; do
    IFS=$'\t' read -r epoch num <<< "${HISTORY_ENTRIES[$i]}"
    datestr=$(date -d "@$epoch" '+%Y-%m-%d %H:%M' 2>/dev/null)
    if [[ $i -eq $HISTORY_SEL ]]; then
      printf '\033[1;92m  ▶ № %-5s\033[0m  \033[0;37m%s\033[0m\n' "$num" "$datestr"
    else
      printf '\033[0;90m    № %-5s  %s\033[0m\n' "$num" "$datestr"
    fi
  done

  echo -e "\n\033[0;90m  ↑↓ navegar  Enter abrir  q sair\033[0m"
}

# Show the history menu; sets HISTORY_SELECTED to the chosen number (or empty)
history_menu() {
  HISTORY_SELECTED=""

  # Load entries: most recent first, deduped by number, capped at 30
  HISTORY_ENTRIES=()
  if [[ -f "$HISTORY_FILE" ]]; then
    local line
    while IFS= read -r line; do
      [[ -n "$line" ]] && HISTORY_ENTRIES+=("$line")
    done < <(tac "$HISTORY_FILE" | awk -F'\t' 'NF==2 && !seen[$2]++' | head -n 30)
  fi

  if [[ ${#HISTORY_ENTRIES[@]} -eq 0 ]]; then
    echo "Sem histórico ainda."
    return
  fi

  HISTORY_SEL=0
  printf '\033[?25l'  # Hide cursor
  stty -icanon -echo
  render_history

  while true; do
    local char seq
    IFS= read -rsn1 char
    case "$char" in
      q|Q)
        return
        ;;
      $'\x1b')
        IFS= read -rsn2 seq
        case "$seq" in
          '[A') ((HISTORY_SEL > 0)) && ((HISTORY_SEL--)); render_history ;;
          '[B') ((HISTORY_SEL < ${#HISTORY_ENTRIES[@]} - 1)) && ((HISTORY_SEL++)); render_history ;;
        esac
        ;;
      $'\r'|$'\n'|'')
        local epoch num
        IFS=$'\t' read -r epoch num <<< "${HISTORY_ENTRIES[$HISTORY_SEL]}"
        HISTORY_SELECTED="$num"
        return
        ;;
    esac
  done
}

cleanup() {
  [[ -n "$ORIG_STTY" ]] && stty "$ORIG_STTY"
  printf '\033[?25h'  # Show cursor
  echo ""
  exit 0
}

# Fetch quotes for $NUM and run the interactive viewer
run_viewer() {
  echo "Loading quotes..."
  fetch_quotes

  # Hide cursor
  printf '\033[?25l'

  render_all

  # Set terminal for single-char input without echo
  stty -icanon -echo

  while true; do
    # Read a single character
    local char
    IFS= read -rsn1 char

    case "$char" in
      q|Q)
        break
        ;;
      $'\x1b')
        # Escape sequence - read more
        IFS= read -rsn2 seq
        case "$seq" in
          '[A') move_up; render_all ;;    # Up arrow
          '[B') move_down; render_all ;;  # Down arrow
        esac
        ;;
      $'\r'|$'\n'|'')
        # Enter key
        handle_enter
        render_all
        ;;
    esac
  done
}

main() {
  case "$1" in
    -h|--history)
      trap cleanup EXIT INT TERM
      history_menu
      # Nothing chosen: restore terminal and quit
      [[ -z "$HISTORY_SELECTED" ]] && exit 0
      NUM="$HISTORY_SELECTED"
      ;;
    *)
      # get_number may exit 1 on bad input; set trap afterwards
      get_number "$1"
      trap cleanup EXIT INT TERM
      ;;
  esac

  record_history
  run_viewer
}

main "$@"
